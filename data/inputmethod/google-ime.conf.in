[InputMethod]
Name=Google IME
Icon=fcitx-cantonese
Label=粵
LangCode=zh
Addon=google-ime
# Expose the GoogleIMEConfig options (src/config.h) under this input method's
# Configure button in the KCM / fcitx5-configtool, mirroring Configurable=True
# in the addon metadata.
Configurable=True
Description=Chinese input via Google Input Tools. Sends romanized input to Google over HTTPS and returns candidate characters. The input layout (Cantonese, Mandarin Pinyin, Wubi, Cangjie, or a custom itc code) is configurable in the addon settings. Requires network access.
